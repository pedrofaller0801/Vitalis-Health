<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
  <meta name="apple-mobile-web-app-capable" content="yes"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <meta name="apple-mobile-web-app-title" content="Vitalis"/>
  <meta name="theme-color" content="#0d1a0a"/>
  <title>Vitalis</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
    html,body{height:100%;background:#0d1a0a;overflow-x:hidden;}
    body{font-family:'DM Sans',sans-serif;color:#e8f0e4;}
    #root{min-height:100vh;}
    input::placeholder,textarea::placeholder{color:#3a5a34;}
    button,input,textarea{font-family:inherit;}
    textarea{-webkit-user-select:text;user-select:text;}
    .safe-top{padding-top:max(52px,env(safe-area-inset-top,0px) + 16px);}
  </style>
</head>
<body>
<div id="root"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js"></script>
<script type="text/babel">
const { useState, useRef } = React;
const STORAGE_KEY = "vitalis_v2";
const DEFAULT_HABITS = [
  { id: 1, label: "Beber 3L de água 💧" },
  { id: 2, label: "Ir na academia 🏋️" },
  { id: 3, label: "Dormir 8h 😴" },
  { id: 4, label: "Meditar 10min 🧘" },
  { id: 5, label: "Comer saudável 🥗" },
];
const DAYS_FULL = ["Domingo","Segunda","Terça","Quarta","Quinta","Sexta","Sábado"];
const MONTHS = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
const MONTHS_SHORT = ["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"];
function todayKey() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function parseKey(key) {
  const [y,m,d] = key.split("-").map(Number);
  return new Date(y, m-1, d);
}
function formatKeyFull(key) {
  const d = parseKey(key);
  return `${DAYS_FULL[d.getDay()]}, ${d.getDate()} de ${MONTHS[d.getMonth()]} de ${d.getFullYear()}`;
}
function formatKeyShort(key) {
  const d = parseKey(key);
  return { day: d.getDate(), month: MONTHS_SHORT[d.getMonth()], weekday: DAYS_FULL[d.getDay()].slice(0,3) };
}
function load() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
}
function persist(data) {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(data)); } catch {}
}
function RingProgress({ percent, size=54, stroke=5 }) {
  const r = (size-stroke)/2, circ = 2*Math.PI*r, offset = circ-(percent/100)*circ;
  return (
    <svg width={size} height={size} style={{transform:"rotate(-90deg)",flexShrink:0}}>
      <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="#1e2d1a" strokeWidth={stroke}/>
      <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={percent===100?"#a8e8a0":"#84cc7a"}
        strokeWidth={stroke} strokeDasharray={circ} strokeDashoffset={offset} strokeLinecap="round"
        style={{transition:"stroke-dashoffset 0.6s cubic-bezier(.4,2,.6,1)"}}/>
    </svg>
  );
}
const iconBtn = {
  background:"rgba(255,255,255,0.05)", border:"1px solid rgba(255,255,255,0.08)",
  borderRadius:12, width:42, height:42, cursor:"pointer", fontSize:18,
  display:"flex", alignItems:"center", justifyContent:"center",
};
const backBtn = {
  background:"none", border:"none", color:"#5a8a52", cursor:"pointer",
  fontSize:14, padding:0, marginBottom:20, display:"flex", alignItems:"center", gap:6
};
const shell = {
  minHeight:"100vh", background:"#0d1a0a", color:"#e8f0e4",
  fontFamily:"'DM Sans',sans-serif", maxWidth:520, margin:"0 auto",
  display:"flex", flexDirection:"column", position:"relative",
};
const bg = {
  position:"fixed", inset:0, pointerEvents:"none", zIndex:0,
  background:"radial-gradient(ellipse at 20% 0%,#1a3d14 0%,transparent 55%),radial-gradient(ellipse at 80% 100%,#0f2a0c 0%,transparent 55%)"
};
function App() {
  const [store, setStore] = useState(load);
  const [screen, setScreen] = useState("diary");
  const [openKey, setOpenKey] = useState(null);
  const [entryTab, setEntryTab] = useState("write");
  const [newHabit, setNewHabit] = useState("");
  const habitInputRef = useRef(null);
  const tk = todayKey();
  const habits = store._habits || DEFAULT_HABITS;
  function update(fn) {
    setStore(prev => {
      const next = fn({...prev});
      persist(next);
      return next;
    });
  }
  function setHabits(fn) {
    update(s => ({...s, _habits: typeof fn==="function" ? fn(s._habits||DEFAULT_HABITS) : fn}));
  }
  const entries = Object.keys(store).filter(k=>!k.startsWith("_")).sort((a,b)=>b.localeCompare(a));
  const hasTodayEntry = !!store[tk];
  const entry = openKey ? (store[openKey]||{text:"",habits:{}}) : null;
  const isToday = openKey===tk;
  const checkedCount = entry ? habits.filter(h=>entry.habits?.[h.id]).length : 0;
  const total = habits.length;
  const percent = total>0 ? Math.round((checkedCount/total)*100) : 0;
  function openEntry(key) { setOpenKey(key); setEntryTab("write"); setScreen("entry"); }
  function addToday() {
    if (!store[tk]) update(s=>({...s,[tk]:{text:"",habits:{}}}));
    openEntry(tk);
  }
  function setText(key, text) { update(s=>({...s,[key]:{...(s[key]||{habits:{}}),text}})); }
  function toggleHabit(key, id) {
    update(s=>{
      const e = s[key]||{text:"",habits:{}};
      return {...s,[key]:{...e,habits:{...e.habits,[id]:!e.habits[id]}}};
    });
  }
  const last7 = Array.from({length:7},(_,i)=>{
    const d=new Date(); d.setDate(d.getDate()-(6-i));
    const k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
    const e=store[k]||{};
    const done=habits.filter(h=>e.habits?.[h.id]).length;
    return {k,label:DAYS_FULL[d.getDay()].slice(0,3),isToday:k===tk,done,pct:total>0?done/total:0};
  });
  const streakCount=(()=>{
    let count=0;
    for(let i=0;i<60;i++){
      const d=new Date(); d.setDate(d.getDate()-i);
      const k=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
      const e=store[k]||{};
      const done=habits.filter(h=>e.habits?.[h.id]).length;
      if(done===0&&i>0) break;
      if(done>0) count++;
    }
    return count;
  })();
  if (screen==="diary") return (
    <div style={shell}>
      <div style={bg}/>
      <div style={{position:"relative",zIndex:1,display:"flex",flexDirection:"column",minHeight:"100vh"}}>
        <div style={{padding:"max(52px, env(safe-area-inset-top, 0px) + 16px) 24px 20px",display:"flex",justifyContent:"space-between",alignItems:"center"}}>
          <div>
            <div style={{fontSize:11,letterSpacing:3,color:"#5a8a52",textTransform:"uppercase",marginBottom:4}}>VITALIS</div>
            <div style={{fontSize:26,fontWeight:800,color:"#c8e8c0"}}>Diário</div>
          </div>
          <div style={{display:"flex",gap:8,alignItems:"center"}}>
            {streakCount>0&&(
              <div style={{background:"#1a3d14",border:"1px solid #3a6030",borderRadius:12,padding:"8px 12px",textAlign:"center"}}>
                <div style={{fontSize:16}}>🔥</div>
                <div style={{fontSize:10,color:"#84cc7a",fontWeight:700}}>{streakCount}d</div>
              </div>
            )}
            <button onClick={()=>setScreen("week")} style={iconBtn}>📊</button>
            <button onClick={()=>setScreen("manage")} style={iconBtn}>⚙️</button>
          </div>
        </div>
        <div style={{padding:"0 24px 20px"}}>
          {!hasTodayEntry ? (
            <button onClick={addToday} style={{width:"100%",padding:"18px",borderRadius:18,background:"linear-gradient(135deg,#2a5220,#1a3d14)",border:"1.5px dashed #3a6030",color:"#84cc7a",fontSize:15,fontWeight:700,cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center",gap:10}}>
              <span style={{fontSize:22}}>✦</span> Adicionar entrada de hoje
            </button>
          ) : (
            <button onClick={()=>openEntry(tk)} style={{width:"100%",padding:"18px",borderRadius:18,background:"linear-gradient(135deg,#2a5220,#1a3d14)",border:"1.5px solid #84cc7a",color:"#84cc7a",fontSize:15,fontWeight:700,cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center",gap:10}}>
              <span style={{fontSize:20}}>📝</span> Continuar hoje
            </button>
          )}
        </div>
        <div style={{padding:"0 24px 48px",display:"flex",flexDirection:"column",gap:12,flex:1}}>
          {entries.length===0&&(
            <div style={{textAlign:"center",color:"#3a5a34",padding:"60px 0",fontSize:14}}>
              Seu diário está vazio.<br/>Adicione sua primeira entrada!
            </div>
          )}
          {entries.map(key=>{
            const e=store[key]||{};
            const done=habits.filter(h=>e.habits?.[h.id]).length;
            const pct=total>0?Math.round(done/total*100):0;
            const fmt=formatKeyShort(key);
            const preview=e.text?e.text.slice(0,80)+(e.text.length>80?"…":""):null;
            const iT=key===tk;
            return (
              <button key={key} onClick={()=>openEntry(key)} style={{display:"flex",gap:14,padding:"16px",borderRadius:18,border:"none",background:iT?"linear-gradient(135deg,#1e3d18,#162d12)":"rgba(255,255,255,0.03)",borderWidth:1,borderStyle:"solid",borderColor:iT?"#3a6030":"rgba(255,255,255,0.07)",cursor:"pointer",textAlign:"left",width:"100%",alignItems:"center"}}>
                <div style={{flexShrink:0,width:48,height:56,borderRadius:14,background:iT?"#84cc7a":"#1a2d16",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center"}}>
                  <div style={{fontSize:10,color:iT?"#0d1a0a":"#5a8a52",fontWeight:700,textTransform:"uppercase"}}>{fmt.month}</div>
                  <div style={{fontSize:22,fontWeight:900,color:iT?"#0d1a0a":"#84cc7a",lineHeight:1}}>{fmt.day}</div>
                  <div style={{fontSize:9,color:iT?"#1a3d14":"#3a5a34"}}>{fmt.weekday}</div>
                </div>
                <div style={{flex:1,minWidth:0}}>
                  {iT&&<div style={{fontSize:10,color:"#84cc7a",fontWeight:700,letterSpacing:1,marginBottom:2}}>HOJE</div>}
                  {preview
                    ?<div style={{fontSize:13,color:"#b0c8a8",lineHeight:1.5,marginBottom:6}}>{preview}</div>
                    :<div style={{fontSize:13,color:"#3a5a34",fontStyle:"italic",marginBottom:6}}>Sem texto…</div>
                  }
                  <div style={{display:"flex",alignItems:"center",gap:8}}>
                    <div style={{height:4,flex:1,background:"#1a2d16",borderRadius:4,overflow:"hidden"}}>
                      <div style={{height:"100%",width:`${pct}%`,background:pct===100?"#a8e8a0":"#84cc7a",borderRadius:4}}/>
                    </div>
                    <div style={{fontSize:11,color:"#5a8a52",flexShrink:0}}>{done}/{total} hábitos</div>
                  </div>
                </div>
              </button>
            );
          })}
        </div>
      </div>
    </div>
  );
  if (screen==="entry"&&entry) return (
    <div style={shell}>
      <div style={bg}/>
      <div style={{position:"relative",zIndex:1,display:"flex",flexDirection:"column",minHeight:"100vh"}}>
        <div style={{padding:"max(52px, env(safe-area-inset-top, 0px) + 16px) 24px 16px"}}>
          <button onClick={()=>setScreen("diary")} style={backBtn}>← Voltar</button>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
            <div>
              <div style={{fontSize:11,color:"#5a8a52",letterSpacing:1}}>{isToday?"HOJE":"SOMENTE LEITURA"}</div>
              <div style={{fontSize:16,fontWeight:700,color:"#c8e8c0",marginTop:2,lineHeight:1.3}}>{formatKeyFull(openKey)}</div>
            </div>
            <div style={{position:"relative"}}>
              <RingProgress percent={percent} size={54} stroke={5}/>
              <div style={{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center"}}>
                <span style={{fontSize:11,fontWeight:800,color:"#84cc7a"}}>{percent}%</span>
              </div>
            </div>
          </div>
        </div>
        <div style={{display:"flex",gap:4,padding:"0 24px 16px"}}>
          {[["write","✍️ Escrita"],["habits","✅ Hábitos"]].map(([t,label])=>(
            <button key={t} onClick={()=>setEntryTab(t)} style={{flex:1,padding:"10px",borderRadius:12,border:"none",background:entryTab===t?"#84cc7a":"rgba(255,255,255,0.04)",color:entryTab===t?"#0d1a0a":"#5a8a52",fontWeight:700,fontSize:13,cursor:"pointer",transition:"all 0.2s"}}>{label}</button>
          ))}
        </div>
        {entryTab==="write"&&(
          <div style={{flex:1,padding:"0 24px 40px"}}>
            {isToday?(
              <textarea value={entry.text||""} onChange={e=>setText(openKey,e.target.value)}
                placeholder={"Como foi o seu dia?\n\nEscreva o quanto quiser…"}
                style={{width:"100%",minHeight:400,background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.08)",borderRadius:18,color:"#d8f0d0",fontSize:15,lineHeight:1.9,padding:"20px",resize:"none",outline:"none",boxSizing:"border-box"}}/>
            ):(
              <div style={{width:"100%",minHeight:200,background:"rgba(255,255,255,0.02)",border:"1px solid rgba(255,255,255,0.06)",borderRadius:18,color:entry.text?"#b0c8a8":"#3a5a34",fontSize:15,lineHeight:1.9,padding:"20px",boxSizing:"border-box",fontStyle:entry.text?"normal":"italic",whiteSpace:"pre-wrap"}}>
                {entry.text||"Nenhum texto foi escrito neste dia."}
              </div>
            )}
            {!isToday&&<div style={{marginTop:12,textAlign:"center",fontSize:12,color:"#3a5a34"}}>🔒 Entradas passadas são somente leitura</div>}
          </div>
        )}
        {entryTab==="habits"&&(
          <div style={{flex:1,padding:"0 24px 40px",display:"flex",flexDirection:"column",gap:10}}>
            {percent===100&&(
              <div style={{background:"#1a3d14",border:"1px solid #3a6030",borderRadius:14,padding:"12px 16px",textAlign:"center",fontSize:13,color:"#84cc7a",marginBottom:4}}>
                🎉 Dia perfeito! Todos os hábitos completos!
              </div>
            )}
            {habits.map(h=>{
              const checked=!!entry.habits?.[h.id];
              return (
                <button key={h.id} onClick={()=>isToday&&toggleHabit(openKey,h.id)}
                  style={{display:"flex",alignItems:"center",gap:14,padding:"16px 18px",background:checked?"linear-gradient(135deg,#1e3d18,#162d12)":"rgba(255,255,255,0.03)",border:checked?"1px solid #3a6030":"1px solid rgba(255,255,255,0.07)",borderRadius:16,cursor:isToday?"pointer":"default",textAlign:"left",transition:"all 0.2s",width:"100%"}}>
                  <div style={{width:26,height:26,borderRadius:8,flexShrink:0,border:checked?"none":"2px solid #3a5a34",background:checked?"#84cc7a":"transparent",display:"flex",alignItems:"center",justifyContent:"center",transition:"all 0.2s"}}>
                    {checked&&<svg width="14" height="11" viewBox="0 0 14 11" fill="none"><path d="M1 5L5.5 9.5L13 1" stroke="#0d1a0a" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"/></svg>}
                  </div>
                  <span style={{fontSize:15,fontWeight:500,color:checked?"#84cc7a":"#b0c8a8",textDecoration:checked?"line-through":"none",opacity:checked?0.85:1}}>{h.label}</span>
                </button>
              );
            })}
            {!isToday&&<div style={{textAlign:"center",fontSize:12,color:"#3a5a34",marginTop:8}}>🔒 Somente leitura</div>}
          </div>
        )}
      </div>
    </div>
  );
  if (screen==="week") return (
    <div style={shell}>
      <div style={bg}/>
      <div style={{position:"relative",zIndex:1,padding:"max(52px, env(safe-area-inset-top, 0px) + 16px) 24px 40px"}}>
        <button onClick={()=>setScreen("diary")} style={backBtn}>← Voltar</button>
        <div style={{fontSize:26,fontWeight:800,color:"#c8e8c0",marginBottom:4}}>Semana</div>
        <div style={{fontSize:13,color:"#5a8a52",marginBottom:24}}>Progresso dos últimos 7 dias</div>
        <div style={{background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.07)",borderRadius:20,padding:"24px 16px",marginBottom:20}}>
          <div style={{display:"flex",alignItems:"flex-end",gap:6,height:150,justifyContent:"space-between"}}>
            {last7.map(({label,isToday:iT,done,pct})=>(
              <div key={label} style={{display:"flex",flexDirection:"column",alignItems:"center",flex:1,gap:6}}>
                <div style={{fontSize:10,color:"#5a8a52"}}>{done>0?done:""}</div>
                <div style={{width:"100%",maxWidth:36,height:Math.max(pct*120,pct>0?8:2),background:iT?"linear-gradient(180deg,#a8e8a0,#84cc7a)":pct>0?"linear-gradient(180deg,#3a6030,#2a4d22)":"#1a2a18",borderRadius:"8px 8px 4px 4px",border:iT?"1px solid #84cc7a":"none",transition:"height 0.6s cubic-bezier(.4,2,.6,1)"}}/>
                <div style={{fontSize:11,color:iT?"#84cc7a":"#3a5a34",fontWeight:iT?700:400}}>{label}</div>
              </div>
            ))}
          </div>
        </div>
        <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
          {[
            {label:"Melhor dia",value:`${Math.round(Math.max(...last7.map(d=>d.pct))*100)}%`,icon:"🏆"},
            {label:"Média semanal",value:`${Math.round(last7.reduce((a,d)=>a+d.pct,0)/7*100)}%`,icon:"📊"},
            {label:"Dias ativos",value:last7.filter(d=>d.done>0).length,icon:"📅"},
            {label:"Sequência",value:`${streakCount}🔥`,icon:""},
          ].map(({label,value,icon})=>(
            <div key={label} style={{background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.07)",borderRadius:16,padding:"16px"}}>
              <div style={{fontSize:20,marginBottom:4}}>{icon}</div>
              <div style={{fontSize:22,fontWeight:800,color:"#84cc7a"}}>{value}</div>
              <div style={{fontSize:11,color:"#5a8a52",marginTop:2}}>{label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
  if (screen==="manage") return (
    <div style={shell}>
      <div style={bg}/>
      <div style={{position:"relative",zIndex:1,padding:"max(52px, env(safe-area-inset-top, 0px) + 16px) 24px 40px"}}>
        <button onClick={()=>setScreen("diary")} style={backBtn}>← Voltar</button>
        <div style={{fontSize:26,fontWeight:800,color:"#c8e8c0",marginBottom:4}}>Hábitos</div>
        <div style={{fontSize:13,color:"#5a8a52",marginBottom:24}}>Personalize seus hábitos diários</div>
        <div style={{display:"flex",gap:8,marginBottom:20}}>
          <input ref={habitInputRef} value={newHabit} onChange={e=>setNewHabit(e.target.value)}
            onKeyDown={e=>{if(e.key==="Enter"){const l=newHabit.trim();if(l){setHabits(prev=>[...prev,{id:Date.now(),label:l}]);setNewHabit("");}}}}
            placeholder="Ex: Ler 30 minutos 📚"
            style={{flex:1,padding:"14px 16px",borderRadius:12,background:"rgba(255,255,255,0.05)",border:"1px solid rgba(255,255,255,0.1)",color:"#e8f0e4",fontSize:14,outline:"none"}}/>
          <button onClick={()=>{const l=newHabit.trim();if(l){setHabits(prev=>[...prev,{id:Date.now(),label:l}]);setNewHabit("");}}}
            style={{padding:"14px 18px",borderRadius:12,border:"none",background:"#84cc7a",color:"#0d1a0a",fontWeight:800,fontSize:18,cursor:"pointer"}}>+</button>
        </div>
        <div style={{display:"flex",flexDirection:"column",gap:8}}>
          {habits.map(h=>(
            <div key={h.id} style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"14px 16px",background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.07)",borderRadius:14}}>
              <span style={{fontSize:14,color:"#b0c8a8"}}>{h.label}</span>
              <button onClick={()=>setHabits(prev=>prev.filter(x=>x.id!==h.id))}
                style={{background:"rgba(255,60,60,0.1)",border:"1px solid rgba(255,60,60,0.2)",borderRadius:8,color:"#ff6b6b",padding:"4px 10px",cursor:"pointer",fontSize:12,fontWeight:600}}>Remover</button>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
  return null;
}
const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App/>);
</script>
</body>
</html>
